# Arquivos temporários do Delphi
*.~*
*.tmp
*.temp
*.bak
*.#*

# Pastas de histórico (em qualquer nível)
__history/
__recovery/
**/__history/
**/__recovery/

# Pasta .qodo (em qualquer nível)
.qodo/
**/.qodo/

# Arquivos de backup automático
*.~pas
*.~dfm
*.~fmx
*.~inc
*.~dpr
*.~dpk
*.~dproj

# Arquivos de debug
*.pdb
*.il

# Arquivos de documentação gerados
*.chm
*.hlp

# Arquivos de teste
*.~test*

# Logs
*.log

# Outros arquivos temporários
Thumbs.db
.DS_Store

# Arquivos locais e de cache
*.local
*.identcache
CustomCache/
**/CustomCache/

# Arquivos específicos do projeto
*.dcu
*.exe
*.dll
*.bpl
*.so
*.dylib

# Pastas de build e output
Win32/
Win64/
Debug/
Release/
Output/
Results/

# Arquivos de configuração do IDE
*.tvsconfig
*.dsk
*.dof
*.cfg
*.res

# Arquivos de cache do WebView2/Edge
EdgeCustomCache/
WVCustomCache/
**/EdgeCustomCache/
**/WVCustomCache/