procedure TFormBrowserTest.BtnBrowserClassChainableTestClick(Sender: TObject);
begin
  BrowserT := TBrowser.Create(TBrowserType.WebBrowser, 'https://google.com.br/')
    .SetCaption('Exemplo')
    .SetWidth(2048)
    .SetHeight(1024)
    .SetActionButtons([TBorderIcon.biMinimize, TBorderIcon.biMaximize])
    .SetResizable(true)
    .SetMovable(true)
    .SetTitleBar(true);
  BrowserT.Show;
end;

