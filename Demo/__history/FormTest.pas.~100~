procedure TFormBrowserTest.FormCreate(Sender: TObject);
begin
  SendMessageMemo.Lines.Text :=
    ' { ' + sLineBreak
  + '   "operation": "putMessage", ' + sLineBreak
  + '   "data":{' + sLineBreak
  + '      "text": "Enviou para o WebView"' + sLineBreak
  + '    }' + sLineBreak
  + ' } ';
end;

procedure TFormBrowserTest.SendMessageBtnClick(Sender: TObject);
begin
  if Assigned(WebView) and (WebView.Instance.ClassType = TWVBrowser) then
    (WebView.Instance as TWVBrowser).PostWebMessageAsString(SendMessageMemo.Text)
  else if Assigned(BrowserI) and (BrowserI.Instance.ClassType = TWVBrowser) then
    (BrowserI.Instance as TWVBrowser).PostWebMessageAsString(SendMessageMemo.Text)
  else if Assigned(BrowserT) and (BrowserT.Instance.ClassType = TWVBrowser) then
    (BrowserT.Instance as TWVBrowser).PostWebMessageAsString(SendMessageMemo.Text)
  else if Assigned(BrowserFormI) and (BrowserFormI.Instance.ClassType = TWVBrowser) then
    (BrowserFormI.Instance as TWVBrowser).PostWebMessageAsString(SendMessageMemo.Text)
  ;
end;

